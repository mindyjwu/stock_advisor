# Copy to .env for `docker compose up`. Do NOT commit the real .env.
ANTHROPIC_API_KEY=
# Strong random secret for signing API tokens (e.g. `openssl rand -hex 32`).
API_SECRET=change-me-to-a-long-random-string
# Postgres password for the bundled db service.
POSTGRES_PASSWORD=stockadvisor
# Optional: SMTP for email alerts (scripts/run_alerts.py). Leave blank to keep
# alerts in-app only. SMTP_FROM defaults to SMTP_USER; SMTP_PORT defaults to 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

ANTHROPIC_API_KEY=

# Optional: Bigdata.com (RavenPack) powers the News Mood layer with
# entity-resolved institutional news instead of scraped Yahoo headlines.
# Set a key (from your Bigdata.com account) to turn it on; leave unset to use
# yfinance news. Username/password is also supported as an alternative.
# BIGDATA_API_KEY=
# BIGDATA_USERNAME=
# BIGDATA_PASSWORD=

# Optional: use Postgres instead of the default local SQLite file.
# Leave unset to keep SQLite (db/advisor.db). When set, the whole app —
# accounts, holdings history, suggestions, decisions, imports — uses Postgres.
# Migrate existing SQLite data with: python3 scripts/migrate_to_postgres.py
# DATABASE_URL=postgresql://user:password@host:5432/stock_advisor

# Optional: SEC EDGAR requires a descriptive User-Agent identifying who's
# fetching (used by the Whale Watch page's 13F lookups). A generic default
# is used if unset; SEC recommends "AppName contact@domain.com".
# SEC_EDGAR_CONTACT=stock-advisor-app you@example.com

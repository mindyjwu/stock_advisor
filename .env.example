ANTHROPIC_API_KEY=

# Optional: use Postgres instead of the default local SQLite file.
# Leave unset to keep SQLite (db/advisor.db). When set, the whole app —
# accounts, holdings history, suggestions, decisions, imports — uses Postgres.
# Migrate existing SQLite data with: python3 scripts/migrate_to_postgres.py
# DATABASE_URL=postgresql://user:password@host:5432/stock_advisor
